---
import { Image } from 'astro:assets';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Divider from '~/components/ui/Divider.astro';
import Link from '~/components/ui/Link.astro';
import { SITE_CONFIG } from '~/config';
import avatar from '../content/about/avatar.jpg';
---

<BaseLayout
  title="whoami"
  description="Security researcher in training. Pentesting, web security, and CTFs."
>
  <!-- Hero -->
  <section class="hero" aria-label="About hero">
    <div class="avatar-wrap">
      <Image
        src={avatar}
        alt="Pablo, aka Lornemalvo"
        width={150}
        height={150}
        densities={[1, 2]}
        loading="eager"
        class="avatar"
      />
    </div>

    <div class="hero-text">
      <div class="terminal-block crt-text">
        <span class="terminal-prompt">lornemalvo:~$ whoami</span>
        <span class="terminal-prompt">pablo</span>
      </div>
      <p class="hero-tagline">Pentester in training. Web security, CTFs, and notes from the field.</p>
    </div>
  </section>

  <Divider variant="subtle" />

  <!-- Bio -->
  <section aria-labelledby="bio-heading">
    <h2 id="bio-heading" class="section-label">About</h2>
    <p>Security enthusiast focused on web application security and penetration testing. Currently working toward OSCP while grinding CTF platforms and building a solid offensive security foundation.</p>
    <p>This blog is a public notebook — writeups, tools, and notes on things I&apos;m learning. If it helps someone else, even better.</p>
  </section>

  <Divider variant="subtle" />

  <!-- Certifications -->
  <section aria-labelledby="certs-heading">
    <h2 id="certs-heading" class="section-label">Certifications</h2>
    <ul class="certs-list">
      <li class="cert-item">
        <span class="cert-badge">eJPT</span>
        <span class="cert-meta">eLearnSecurity · 2024</span>
      </li>
      <li class="cert-item">
        <span class="cert-badge">OSCP</span>
        <span class="cert-meta">Offensive Security · in progress</span>
      </li>
    </ul>
  </section>

  <Divider variant="subtle" />

  <!-- Platforms -->
  <section aria-labelledby="platforms-heading">
    <h2 id="platforms-heading" class="section-label">Platforms</h2>
    <ul class="link-list">
      <li><Link href="https://app.hackthebox.com/u/l0rnemalv0" external>HackTheBox</Link></li>
      <li><Link href={SITE_CONFIG.GITHUB_URL} external>GitHub</Link></li>
    </ul>
  </section>

  <Divider variant="subtle" />

  <!-- Contact -->
  <section aria-labelledby="contact-heading">
    <h2 id="contact-heading" class="section-label">Contact</h2>
    <ul class="link-list">
      <li><Link href={SITE_CONFIG.TWITTER_URL} external>Twitter / X</Link></li>
      <li><Link href="mailto:vilallavepablo@gmail.com" external>vilallavepablo@gmail.com</Link></li>
    </ul>
  </section>
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-6);
    padding-block: var(--space-10) var(--space-2);
  }

  @media (min-width: 640px) {
    .hero {
      flex-direction: row;
      align-items: center;
      text-align: left;
      gap: var(--space-8);
      padding-block: var(--space-8) var(--space-2);
    }
  }

  .avatar-wrap {
    flex-shrink: 0;
  }

  .avatar {
    display: block;
    width: 150px;
    height: 150px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    /* The source is already square, so this is a no-op today — it is here so
       a non-square replacement crops instead of stretching. */
    object-fit: cover;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
  }

  .terminal-block {
    display: flex;
    flex-direction: column;
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    line-height: 1.2;
  }

  .terminal-prompt {
    font-weight: var(--font-medium);
    color: var(--accent-white);
  }

  .terminal-output {
    font-weight: var(--font-bold);
    color: var(--accent);
  }

  .hero-tagline {
    font-size: var(--text-sm);
    color: var(--fg-muted);
    line-height: var(--leading-normal);
    margin-top: var(--space-4);
  }

  /* ── Section headings ── */
  .section-label {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-4);
  }

  /* ── Bio ── */
  section p {
    line-height: var(--leading-relaxed);
    color: var(--fg);
  }

  section p + p {
    margin-top: var(--space-4);
  }

  /* ── Certifications ── */
  .certs-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    list-style: none;
  }

  .cert-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .cert-badge {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    line-height: 1;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: var(--radius-sm);
    padding: var(--space-1) var(--space-2);
  }

  .cert-meta {
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  /* ── Platforms / Contact ── */
  .link-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    list-style: none;
  }
</style>
