---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Prose from '~/components/ui/Prose.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  tags: string[];
  category: 'writeup' | 'article' | 'note';
  difficulty?: 'easy' | 'medium' | 'hard' | 'insane';
}

const { title, description, date, updated, tags, category, difficulty } = Astro.props;

const dateStr = date.toLocaleDateString('en-CA');
const updatedStr = updated?.toLocaleDateString('en-CA');

const difficultyColors: Record<string, string> = {
  easy:   '#57ab5a',
  medium: '#e3b341',
  hard:   '#f47067',
  insane: '#a475f9',
};
---

<BaseLayout title={title} description={description}>
  <article>
    <header class="post-header">
      <div class="meta">
        <time datetime={date.toISOString()}>{dateStr}</time>
        <span class="category">{category}</span>
        {difficulty && (
          <span class="difficulty" style={`color: ${difficultyColors[difficulty]}`}>
            {difficulty}
          </span>
        )}
      </div>

      <h1>{title}</h1>
      <p class="description">{description}</p>

      {tags.length > 0 && (
        <ul class="tags">
          {tags.map((tag) => (
            <li><a href={`/tags/${tag}`}>#{tag}</a></li>
          ))}
        </ul>
      )}

      {updatedStr && (
        <p class="updated">Updated: {updatedStr}</p>
      )}
    </header>

    <Prose>
      <slot />
    </Prose>
  </article>
</BaseLayout>

<style>
  .post-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.75rem;
    color: var(--fg-muted);
    margin-bottom: 0.75rem;
  }

  .category {
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.625rem;
    border: 1px solid var(--border);
    padding: 0 0.375rem;
    border-radius: 2px;
  }

  .difficulty {
    font-weight: 500;
  }

  h1 {
    font-size: 1.875rem;
    font-weight: 700;
    line-height: 1.25;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  .description {
    color: var(--fg-muted);
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin-bottom: 0.75rem;
  }

  .tags a {
    font-size: 0.75rem;
    color: var(--fg-muted);
  }

  .tags a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .updated {
    font-size: 0.75rem;
    color: var(--fg-muted);
  }
</style>
