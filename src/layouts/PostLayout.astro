---
import BaseLayout from '~/layouts/BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  tags: string[];
  category: 'writeup' | 'article' | 'note';
  difficulty?: 'easy' | 'medium' | 'hard' | 'insane';
}

const { title, description, date, updated, tags, category, difficulty } = Astro.props;

const dateStr = date.toLocaleDateString('en-CA');
const updatedStr = updated?.toLocaleDateString('en-CA');

const difficultyColors: Record<string, string> = {
  easy:   '#57ab5a',
  medium: '#e3b341',
  hard:   '#f47067',
  insane: '#a475f9',
};
---

<BaseLayout title={title} description={description}>
  <article>
    <header class="post-header">
      <div class="meta">
        <time datetime={date.toISOString()}>{dateStr}</time>
        <span class="category">{category}</span>
        {difficulty && (
          <span class="difficulty" style={`color: ${difficultyColors[difficulty]}`}>
            {difficulty}
          </span>
        )}
      </div>

      <h1>{title}</h1>
      <p class="description">{description}</p>

      {tags.length > 0 && (
        <ul class="tags">
          {tags.map((tag) => (
            <li><a href={`/tags/${tag}`}>#{tag}</a></li>
          ))}
        </ul>
      )}

      {updatedStr && (
        <p class="updated">Updated: {updatedStr}</p>
      )}
    </header>

    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .post-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.75rem;
    color: var(--fg-muted);
    margin-bottom: 0.75rem;
  }

  .category {
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.625rem;
    border: 1px solid var(--border);
    padding: 0 0.375rem;
    border-radius: 2px;
  }

  .difficulty {
    font-weight: 500;
  }

  h1 {
    font-size: 1.875rem;
    font-weight: 700;
    line-height: 1.25;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  .description {
    color: var(--fg-muted);
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin-bottom: 0.75rem;
  }

  .tags a {
    font-size: 0.75rem;
    color: var(--fg-muted);
  }

  .tags a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .updated {
    font-size: 0.75rem;
    color: var(--fg-muted);
  }

  /* ── Prose styles ── */
  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    color: var(--fg);
    font-weight: 600;
    line-height: 1.3;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .prose :global(h2) { font-size: 1.5rem; }
  .prose :global(h3) { font-size: 1.25rem; }
  .prose :global(h4) { font-size: 1.125rem; }

  .prose :global(p) {
    margin-bottom: 1.25rem;
    line-height: 1.7;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .prose :global(li) {
    margin-bottom: 0.375rem;
    line-height: 1.7;
  }

  .prose :global(code:not(pre code)) {
    background: var(--bg-soft);
    color: var(--accent);
    padding: 0.1em 0.35em;
    border-radius: 3px;
    font-size: 0.875em;
  }

  .prose :global(blockquote) {
    border-left: 2px solid var(--accent);
    padding-left: 1rem;
    color: var(--fg-muted);
    font-style: italic;
    margin: 1.5rem 0;
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2rem 0;
  }

  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: var(--accent-dim);
    text-underline-offset: 2px;
  }

  .prose :global(strong) {
    font-weight: 600;
    color: var(--fg);
  }

  .prose :global(.expressive-code) {
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }
</style>
