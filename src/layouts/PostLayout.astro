---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Prose from '~/components/ui/Prose.astro';
import Divider from '~/components/ui/Divider.astro';
import Tag from '~/components/ui/Tag.astro';
import { getReadingTime, formatDate } from '~/lib/posts';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, description, date, updated, tags, difficulty } = post.data;

const readingTime = getReadingTime(post.body ?? '');
const dateStr = formatDate(date);
const updatedStr = updated ? formatDate(updated) : null;
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  publishDate={date}
  tags={tags}
>
  <article>
    <header class="post-header">
      <div class="meta">
        <time datetime={date.toISOString()}>{dateStr}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime} min read</span>
        {difficulty && <span aria-hidden="true">·</span>}
        {difficulty && (
          <span class:list={['difficulty', `difficulty-${difficulty}`]}>
            {difficulty}
          </span>
        )}
      </div>

      <h1>{title}</h1>

      {description && <p class="description">{description}</p>}

      {tags.length > 0 && (
        <ul class="tags">
          {tags.map((tag) => (
            <li><Tag name={tag} /></li>
          ))}
        </ul>
      )}

      {updatedStr && <p class="updated">Updated: {updatedStr}</p>}
    </header>

    <Divider />

    <Prose>
      <slot />
    </Prose>
  </article>
</BaseLayout>

<style>
  article {
    max-width: var(--measure);
    margin-inline: auto;
  }

  .post-header {
    margin-bottom: var(--space-2);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--fg-muted);
    margin-bottom: var(--space-3);
  }

  .difficulty {
    font-weight: var(--font-medium);
    text-transform: lowercase;
  }
  .difficulty-easy   { color: #57ab5a; }
  .difficulty-medium { color: var(--warning); }
  .difficulty-hard   { color: color-mix(in srgb, var(--danger) 65%, var(--fg-muted)); }
  .difficulty-insane { color: var(--danger); }

  h1 {
    font-size: var(--text-3xl);
    font-weight: var(--font-bold);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-3);
  }

  .description {
    font-size: var(--text-lg);
    color: var(--fg-muted);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-4);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
  }

  .updated {
    font-size: var(--text-xs);
    color: var(--fg-muted);
    margin-top: var(--space-3);
  }
</style>
