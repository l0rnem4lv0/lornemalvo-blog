---
import type { CollectionEntry } from 'astro:content';
import Divider from '~/components/ui/Divider.astro';
import Tag from '~/components/ui/Tag.astro';
import { getReadingTime, formatDate } from '~/lib/posts';

interface Props {
  post: CollectionEntry<'posts'>;
  showDivider?: boolean;
}

const { post, showDivider = true } = Astro.props;
const { title, description, date, tags, difficulty } = post.data;

const readingTime = getReadingTime(post.body ?? '');
const dateStr = formatDate(date);
---

{showDivider && <Divider />}

<article class="post-card">
  <div class="post-meta">
    <time datetime={date.toISOString()}>{dateStr}</time>
    <span aria-hidden="true">·</span>
    <span>{readingTime} min read</span>
    {difficulty && <span aria-hidden="true">·</span>}
    {difficulty && (
      <span class:list={['difficulty', `difficulty-${difficulty}`]}>
        {difficulty}
      </span>
    )}
  </div>

  <h2>
    <a href={`/posts/${post.id}`}>{title}</a>
  </h2>

  <p>{description}</p>

  {tags.length > 0 && (
    <div class="post-tags">
      {tags.map((tag) => <Tag name={tag} />)}
    </div>
  )}
</article>

<style>
  .post-card {
    position: relative;
    padding-left: var(--space-4);
    border-left: 2px solid transparent;
    transition: border-color var(--transition-base) var(--ease-out);
  }

  .post-card:hover,
  .post-card:focus-within {
    border-left-color: var(--accent);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--fg-muted);
    margin-bottom: var(--space-2);
  }

  .difficulty { font-weight: var(--font-medium); }
  .difficulty-easy   { color: #57ab5a; }
  .difficulty-medium { color: var(--warning); }
  .difficulty-hard   { color: color-mix(in srgb, var(--danger) 65%, var(--fg-muted)); }
  .difficulty-insane { color: var(--danger); }

  h2 {
    font-size: var(--text-xl);
    font-weight: var(--font-semibold);
    line-height: var(--leading-snug);
    margin: var(--space-1) 0 var(--space-2);
  }

  h2 a {
    color: var(--fg);
    text-decoration: none;
    transition: color var(--transition-fast) ease;
  }

  h2 a:hover {
    color: var(--accent);
  }

  /* Stretched link — whole card surface is clickable via the title link */
  h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  p {
    color: var(--fg-muted);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-3);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Tags sit above the stretched link overlay */
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    position: relative;
    z-index: 1;
  }
</style>
