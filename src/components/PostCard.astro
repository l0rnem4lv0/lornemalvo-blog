---
interface Props {
  title: string;
  description: string;
  date: Date;
  slug: string;
  category: 'writeup' | 'article' | 'note';
  difficulty?: 'easy' | 'medium' | 'hard' | 'insane';
  tags: string[];
}

const { title, description, date, slug, category, difficulty, tags } = Astro.props;

const dateStr = date.toLocaleDateString('en-CA'); // YYYY-MM-DD
const difficultyColors: Record<string, string> = {
  easy:   'color: #57ab5a',
  medium: 'color: #e3b341',
  hard:   'color: #f47067',
  insane: 'color: #a475f9',
};
---

<article>
  <div class="meta">
    <time datetime={date.toISOString()}>{dateStr}</time>
    <span class="category">{category}</span>
    {difficulty && (
      <span class="difficulty" style={difficultyColors[difficulty]}>
        {difficulty}
      </span>
    )}
  </div>

  <a href={`/posts/${slug}`} class="title-link">
    <h2>{title}</h2>
  </a>

  <p class="description">{description}</p>

  {tags.length > 0 && (
    <ul class="tags">
      {tags.map((tag) => (
        <li>
          <a href={`/tags/${tag}`}>#{tag}</a>
        </li>
      ))}
    </ul>
  )}
</article>

<style>
  article {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.75rem;
    color: var(--fg-muted);
    margin-bottom: 0.375rem;
  }

  .category {
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.625rem;
    border: 1px solid var(--border);
    padding: 0 0.375rem;
    border-radius: 2px;
  }

  .difficulty {
    font-size: 0.75rem;
    font-weight: 500;
  }

  .title-link {
    display: block;
    color: var(--fg);
  }

  .title-link:hover {
    color: var(--accent);
    text-decoration: none;
  }

  h2 {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.4;
    margin-bottom: 0.375rem;
  }

  .description {
    font-size: 0.875rem;
    color: var(--fg-muted);
    line-height: 1.6;
    margin-bottom: 0.625rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
  }

  .tags a {
    font-size: 0.75rem;
    color: var(--fg-muted);
    transition: color 150ms ease;
  }

  .tags a:hover {
    color: var(--accent);
    text-decoration: none;
  }
</style>
