---
import { Icon } from 'astro-icon/components';
import { SITE_CONFIG } from '~/config';

const year = new Date().getFullYear();

const socials = [
  { label: 'GitHub', href: SITE_CONFIG.GITHUB_URL, icon: 'lucide:github' },
  { label: 'Twitter', href: SITE_CONFIG.TWITTER_URL, icon: 'lucide:twitter' },
  { label: 'RSS feed', href: '/rss.xml', icon: 'lucide:rss' },
];
---

<footer aria-label="Site footer" data-pagefind-ignore>
  <div class="inner">
    <p class="copy">© {year} Lornemalvo</p>
    <ul class="socials">
      {socials.map(({ label, href, icon }) => {
        const external = /^https?:\/\//.test(href);
        return (
          <li>
            <a
              href={href}
              aria-label={label}
              title={label}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener noreferrer' : undefined}
            >
              <Icon name={icon} aria-hidden="true" />
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</footer>

<style>
  footer {
    margin-top: var(--space-16);
    border-top: 1px solid var(--border);
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    max-width: var(--container-wide);
    margin-inline: auto;
    padding: var(--space-6) var(--space-4);
  }

  @media (min-width: 640px) {
    .inner {
      padding-inline: var(--space-6);
    }
  }

  .copy {
    margin: 0;
  }

  .socials {
    display: flex;
    gap: var(--space-2);
    list-style: none;
  }

  .socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    color: var(--fg-muted);
    text-decoration: none;
    border-radius: var(--radius-md);
    transition: color var(--transition-fast) ease;
  }

  .socials a:hover {
    color: var(--accent);
  }

  .socials :global(svg) {
    width: 1rem;
    height: 1rem;
  }
</style>
