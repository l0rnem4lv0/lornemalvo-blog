---
/**
 * ASCII plasma — decorative full-page background layer.
 *
 * Renders a classic sum-of-sines plasma field, quantised into a glyph ramp
 * and coloured with the site's own accent tokens (read live from :root, so
 * it tracks the palette instead of hardcoding hexes).
 *
 * Deliberately self-hosted: the layer is a single bundled module served from
 * our own origin, so `script-src 'self'` in public/_headers stays intact.
 */
interface Props {
  /** Glyph cell size in CSS px. Bigger = coarser and cheaper to draw. */
  cellSize?: number;
  /** Animation rate multiplier. */
  speed?: number;
  /** Quantisation steps across the glyph ramp. */
  levels?: number;
  /** Spatial scale of the field — bigger = broader, slower blobs. */
  scale?: number;
  /** Contrast applied around mid-level before quantisation. */
  contrast?: number;
  /** 0–1, how much odd rows are dimmed (CRT feel). */
  scanlines?: number;
  /** 0–1, subtle per-frame luminance jitter. */
  flicker?: number;
  /** Overall layer opacity — the "keep it subtle" knob. */
  opacity?: number;
}

const {
  cellSize = 12,
  speed = 0.46,
  levels = 10,
  scale = 4,
  contrast = 1.13,
  scanlines = 0.21,
  flicker = 1,
  opacity = 0.055,
} = Astro.props;
---

<canvas
  class="ascii-plasma"
  data-ascii-plasma
  data-cell-size={cellSize}
  data-speed={speed}
  data-levels={levels}
  data-scale={scale}
  data-contrast={contrast}
  data-scanlines={scanlines}
  data-flicker={flicker}
  style={`--plasma-opacity:${opacity}`}
  aria-hidden="true"></canvas>

<style>
  .ascii-plasma {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    /* Negative z-index paints above the propagated html background but below
       all normal-flow content, so no wrapper needs a stacking context.
       -2 keeps it strictly under the post reading veil at -1. */
    z-index: -2;
    pointer-events: none;
    opacity: var(--plasma-opacity);
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-ascii-plasma]');
  const ctx = canvas?.getContext('2d', { alpha: true });

  if (canvas && ctx) {
    const data = canvas.dataset;
    const num = (key: string, fallback: number) => {
      const parsed = Number.parseFloat(data[key] ?? '');
      return Number.isFinite(parsed) ? parsed : fallback;
    };

    const cell = Math.max(4, num('cellSize', 12));
    const speed = num('speed', 0.46);
    const levels = Math.max(2, Math.round(num('levels', 10)));
    const scale = Math.max(0.5, num('scale', 4));
    const contrast = num('contrast', 1.13);
    const scanlines = Math.min(1, Math.max(0, num('scanlines', 0.21)));
    const flicker = Math.min(1, Math.max(0, num('flicker', 1)));

    // Densest glyph last — the ramp is sampled, so `levels` can differ from its length.
    const GLYPHS = ' .:-=+*#%@';
    const MONO =
      "'JetBrains Mono Variable', ui-monospace, 'SF Mono', Menlo, monospace";
    const FPS_CAP = 24;
    const FRAME_MS = 1000 / FPS_CAP;

    type RGB = [number, number, number];

    const hexToRgb = (hex: string): RGB => {
      const raw = hex.trim().replace('#', '');
      const full =
        raw.length === 3
          ? raw
              .split('')
              .map((c) => c + c)
              .join('')
          : raw;
      const n = Number.parseInt(full, 16);
      return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
    };

    // Colours come from the live palette tokens, not baked-in hexes.
    // --plasma-base is the darkest stop and the one worth tuning; see global.css.
    const css = getComputedStyle(document.documentElement);
    const readStop = (token: string, fallback: string): RGB => {
      const value = css.getPropertyValue(token).trim();
      if (value) return hexToRgb(value);
      // Warn rather than drop: a mistyped token would otherwise silently
      // shorten the ramp and quietly change the gradient.
      console.warn(`[ascii-plasma] unknown CSS token ${token}, using ${fallback}`);
      return hexToRgb(fallback);
    };

    const stops: RGB[] = [
      readStop('--plasma-base', '#0e2119'),
      readStop('--accent', '#00ff9c'),
      readStop('--accent-white', '#c6ffd1'),
    ];

    const rampColor = (t: number): RGB => {
      const span = stops.length - 1;
      const pos = Math.min(0.999999, Math.max(0, t)) * span;
      const i = Math.floor(pos);
      const f = pos - i;
      const a = stops[i];
      const b = stops[i + 1] ?? a;
      return [
        Math.round(a[0] + (b[0] - a[0]) * f),
        Math.round(a[1] + (b[1] - a[1]) * f),
        Math.round(a[2] + (b[2] - a[2]) * f),
      ];
    };

    // Pre-render one sprite per level: per-frame work becomes drawImage
    // instead of thousands of fillText calls.
    let sprites: HTMLCanvasElement[] = [];
    const buildSprites = (dpr: number) => {
      sprites = [];
      for (let level = 0; level < levels; level++) {
        const t = level / (levels - 1);
        const glyph = GLYPHS[Math.round(t * (GLYPHS.length - 1))];
        const sprite = document.createElement('canvas');
        sprite.width = Math.ceil(cell * dpr);
        sprite.height = Math.ceil(cell * dpr);
        const sctx = sprite.getContext('2d');
        if (sctx && glyph !== ' ') {
          sctx.scale(dpr, dpr);
          sctx.font = `${Math.round(cell * 0.95)}px ${MONO}`;
          sctx.textAlign = 'center';
          sctx.textBaseline = 'middle';
          const [r, g, b] = rampColor(t);
          sctx.fillStyle = `rgb(${r},${g},${b})`;
          sctx.fillText(glyph, cell / 2, cell / 2);
        }
        sprites.push(sprite);
      }
    };

    let cols = 0;
    let rows = 0;
    let cx = 0;
    let cy = 0;
    let dpr = 1;

    const resize = () => {
      // Cap DPR: this is a low-opacity texture, retina fidelity buys nothing
      // and quadruples fill rate.
      dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      const w = window.innerWidth;
      const h = window.innerHeight;
      canvas.width = Math.ceil(w * dpr);
      canvas.height = Math.ceil(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cols = Math.ceil(w / cell) + 1;
      rows = Math.ceil(h / cell) + 1;
      cx = cols / 2 / scale;
      cy = rows / 2 / scale;
      buildSprites(dpr);
    };

    const field = (x: number, y: number, t: number) => {
      const sx = x / scale;
      const sy = y / scale;
      const dx = sx - cx;
      const dy = sy - cy;
      const v =
        Math.sin(sx * 0.5 + t) +
        Math.sin(sy * 0.4 - t * 0.7) +
        Math.sin((sx + sy) * 0.3 + t * 1.1) +
        Math.sin(Math.sqrt(dx * dx + dy * dy) * 0.4 - t * 0.9);
      return (v + 4) / 8;
    };

    const draw = (t: number) => {
      ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
      const jitter = flicker ? 1 - flicker * 0.06 * Math.random() : 1;

      for (let gy = 0; gy < rows; gy++) {
        ctx.globalAlpha = (gy % 2 === 1 ? 1 - scanlines : 1) * jitter;
        const py = gy * cell;
        for (let gx = 0; gx < cols; gx++) {
          let v = field(gx, gy, t);
          v = (v - 0.5) * contrast + 0.5;
          let level = Math.floor(v * levels);
          // Level 0 is the blank glyph — skipping it is the cheap early-out.
          if (level < 1) continue;
          if (level > levels - 1) level = levels - 1;
          ctx.drawImage(sprites[level], gx * cell, py, cell, cell);
        }
      }
      ctx.globalAlpha = 1;
    };

    /* Any texture painted over --bg lifts the average tone, so a flat surface
       filled with --bg reads darker than the area showing the effect. Measure
       what the layer actually composites to and publish it as --bg-flat, so
       opaque surfaces (header, post reading veil) can match the field instead
       of hardcoding a constant that silently drifts whenever the effect is
       retuned. */
    const publishFlatTone = () => {
      try {
        const { width, height } = canvas;
        if (!width || !height) return;
        const pixels = ctx.getImageData(0, 0, width, height).data;
        // Every 4th pixel: an average this large does not need every sample.
        const STEP = 16;
        let sumR = 0;
        let sumG = 0;
        let sumB = 0;
        let sumA = 0;
        let n = 0;
        for (let i = 0; i < pixels.length; i += STEP) {
          const a = pixels[i + 3] / 255;
          sumR += pixels[i] * a;
          sumG += pixels[i + 1] * a;
          sumB += pixels[i + 2] * a;
          sumA += a;
          n++;
        }
        if (!n) return;
        const layerAlpha = Number.parseFloat(getComputedStyle(canvas).opacity) || 0;
        const base = hexToRgb(css.getPropertyValue('--bg').trim() || '#050505');
        const meanA = sumA / n;
        const mix = (sumC: number, baseC: number) =>
          Math.round(baseC * (1 - meanA * layerAlpha) + (sumC / n) * layerAlpha);
        document.documentElement.style.setProperty(
          '--bg-flat',
          `rgb(${mix(sumR, base[0])} ${mix(sumG, base[1])} ${mix(sumB, base[2])})`,
        );
      } catch {
        // getImageData can throw on a tainted canvas; the CSS fallback covers it.
      }
    };

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let raf = 0;
    let last = 0;

    const loop = (now: number) => {
      raf = requestAnimationFrame(loop);
      if (now - last < FRAME_MS) return;
      last = now;
      draw(now * 0.001 * speed);
    };

    const stop = () => {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
    };

    const start = () => {
      stop();
      // Draw once up front so there is a frame to measure the tone from.
      draw(reduceMotion.matches ? 0 : performance.now() * 0.001 * speed);
      publishFlatTone();
      // Static single frame under reduced motion: texture stays, motion does not.
      if (reduceMotion.matches) return;
      raf = requestAnimationFrame(loop);
    };

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        resize();
        if (reduceMotion.matches) draw(0);
      }, 150);
    });

    // Don't burn CPU animating a background nobody is looking at.
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });

    reduceMotion.addEventListener('change', start);

    resize();
    start();
  }
</script>
