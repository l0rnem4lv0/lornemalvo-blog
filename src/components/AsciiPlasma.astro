---
/**
 * ASCII plasma — decorative full-page background layer.
 *
 * Renders a classic sum-of-sines plasma field, quantised into a glyph ramp
 * and coloured with the site's own accent tokens (read live from :root, so
 * it tracks the palette instead of hardcoding hexes).
 *
 * Deliberately self-hosted: the layer is a single bundled module served from
 * our own origin, so `script-src 'self'` in public/_headers stays intact.
 */
interface Props {
  /** Glyph cell size in CSS px. Bigger = coarser and cheaper to draw. */
  cellSize?: number;
  /** Animation rate multiplier. */
  speed?: number;
  /** Quantisation steps across the glyph ramp. */
  levels?: number;
  /** Spatial scale of the field — bigger = broader, slower blobs. */
  scale?: number;
  /** Contrast applied around mid-level before quantisation. */
  contrast?: number;
  /** 0–1, how much odd rows are dimmed (CRT feel). */
  scanlines?: number;
  /** 0–1, subtle per-frame luminance jitter. */
  flicker?: number;
  /** Overall layer opacity — the "keep it subtle" knob. */
  opacity?: number;
}

const {
  cellSize = 12,
  speed = 0.46,
  levels = 10,
  scale = 4,
  contrast = 1.13,
  scanlines = 0.21,
  flicker = 1,
  opacity = 0.055,
} = Astro.props;
---

<canvas
  class="ascii-plasma"
  data-ascii-plasma
  data-cell-size={cellSize}
  data-speed={speed}
  data-levels={levels}
  data-scale={scale}
  data-contrast={contrast}
  data-scanlines={scanlines}
  data-flicker={flicker}
  style={`--plasma-opacity:${opacity}`}
  aria-hidden="true"></canvas>

<style>
  .ascii-plasma {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    /* Negative z-index paints above the propagated html background but below
       all normal-flow content, so no wrapper needs a stacking context.
       -2 keeps it strictly under the post reading veil at -1. */
    z-index: -2;
    pointer-events: none;
    opacity: var(--plasma-opacity);
  }

  /* Reading column, posts only. --veil-dim is how much of the effect survives
     inside the column (0 = gone, 1 = untouched); --veil-soft is how far the
     transition takes. Both are meant to be tuned. */
  .ascii-plasma[data-veiled] {
    --veil-dim: 0.34;
    --veil-soft: 17rem;
    --veil-mask: linear-gradient(
      to right,
      #000 calc(var(--veil-l, 0px) - var(--veil-soft)),
      rgba(0, 0, 0, var(--veil-dim)) var(--veil-l, 0px),
      rgba(0, 0, 0, var(--veil-dim)) var(--veil-r, 100%),
      #000 calc(var(--veil-r, 100%) + var(--veil-soft))
    );
    -webkit-mask-image: var(--veil-mask);
    mask-image: var(--veil-mask);
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-ascii-plasma]');
  const ctx = canvas?.getContext('2d', { alpha: true });

  if (canvas && ctx) {
    const data = canvas.dataset;
    const num = (key: string, fallback: number) => {
      const parsed = Number.parseFloat(data[key] ?? '');
      return Number.isFinite(parsed) ? parsed : fallback;
    };

    const cell = Math.max(4, num('cellSize', 12));
    const speed = num('speed', 0.46);
    const levels = Math.max(2, Math.round(num('levels', 10)));
    const scale = Math.max(0.5, num('scale', 4));
    const contrast = num('contrast', 1.13);
    const scanlines = Math.min(1, Math.max(0, num('scanlines', 0.21)));
    const flicker = Math.min(1, Math.max(0, num('flicker', 1)));

    // Densest glyph last — the ramp is sampled, so `levels` can differ from its length.
    const GLYPHS = ' .:-=+*#%@';
    const MONO =
      "'JetBrains Mono Variable', ui-monospace, 'SF Mono', Menlo, monospace";
    const FPS_CAP = 24;
    const FRAME_MS = 1000 / FPS_CAP;

    type RGB = [number, number, number];

    const hexToRgb = (hex: string): RGB => {
      const raw = hex.trim().replace('#', '');
      const full =
        raw.length === 3
          ? raw
              .split('')
              .map((c) => c + c)
              .join('')
          : raw;
      const n = Number.parseInt(full, 16);
      return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
    };

    /* One ink, never a ramp.
       A colour ramp whose dark end sits near the background luminance does not
       read as characters — it reads as the background being a slightly
       different colour, which is the tint we are avoiding. With a single ink
       every pixel is either a legible glyph or untouched background, so --bg
       stays the only background colour there is to control. Level selects the
       glyph, and nothing else. */
    const css = getComputedStyle(document.documentElement);
    const readInk = (): RGB => {
      const value =
        css.getPropertyValue('--plasma-ink').trim() ||
        css.getPropertyValue('--accent').trim();
      if (value) return hexToRgb(value);
      console.warn('[ascii-plasma] no --plasma-ink or --accent, using #00ff9c');
      return hexToRgb('#00ff9c');
    };
    const ink = readInk();

    // Pre-render one sprite per level: per-frame work becomes drawImage
    // instead of thousands of fillText calls.
    let sprites: HTMLCanvasElement[] = [];
    const buildSprites = (dpr: number) => {
      sprites = [];
      for (let level = 0; level < levels; level++) {
        const t = level / (levels - 1);
        const glyph = GLYPHS[Math.round(t * (GLYPHS.length - 1))];
        const sprite = document.createElement('canvas');
        sprite.width = Math.ceil(cell * dpr);
        sprite.height = Math.ceil(cell * dpr);
        const sctx = sprite.getContext('2d');
        if (sctx && glyph !== ' ') {
          sctx.scale(dpr, dpr);
          sctx.font = `${Math.round(cell * 0.95)}px ${MONO}`;
          sctx.textAlign = 'center';
          sctx.textBaseline = 'middle';
          sctx.fillStyle = `rgb(${ink[0]},${ink[1]},${ink[2]})`;
          sctx.fillText(glyph, cell / 2, cell / 2);
        }
        sprites.push(sprite);
      }
    };

    let cols = 0;
    let rows = 0;
    let cx = 0;
    let cy = 0;
    let dpr = 1;

    const resize = () => {
      // Cap DPR: this is a low-opacity texture, retina fidelity buys nothing
      // and quadruples fill rate.
      dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      const w = window.innerWidth;
      const h = window.innerHeight;
      canvas.width = Math.ceil(w * dpr);
      canvas.height = Math.ceil(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cols = Math.ceil(w / cell) + 1;
      rows = Math.ceil(h / cell) + 1;
      cx = cols / 2 / scale;
      cy = rows / 2 / scale;
      buildSprites(dpr);
      syncColumnMask();
      if (mirror) mirror.style.opacity = getComputedStyle(canvas).opacity;
    };

    const field = (x: number, y: number, t: number) => {
      const sx = x / scale;
      const sy = y / scale;
      const dx = sx - cx;
      const dy = sy - cy;
      const v =
        Math.sin(sx * 0.5 + t) +
        Math.sin(sy * 0.4 - t * 0.7) +
        Math.sin((sx + sy) * 0.3 + t * 1.1) +
        Math.sin(Math.sqrt(dx * dx + dy * dy) * 0.4 - t * 0.9);
      return (v + 4) / 8;
    };

    const draw = (t: number) => {
      ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
      const jitter = flicker ? 1 - flicker * 0.06 * Math.random() : 1;

      for (let gy = 0; gy < rows; gy++) {
        ctx.globalAlpha = (gy % 2 === 1 ? 1 - scanlines : 1) * jitter;
        const py = gy * cell;
        for (let gx = 0; gx < cols; gx++) {
          let v = field(gx, gy, t);
          v = (v - 0.5) * contrast + 0.5;
          let level = Math.floor(v * levels);
          // Level 0 is the blank glyph — skipping it is the cheap early-out.
          if (level < 1) continue;
          if (level > levels - 1) level = levels - 1;
          ctx.drawImage(sprites[level], gx * cell, py, cell, cell);
        }
      }
      ctx.globalAlpha = 1;
      blitMirror();
    };

    /* Reading column: dim the field rather than cover it.
       The field is not one colour — sampled across a post it swings from 5.00
       to 8.16 in green — so any flat patch reads as a different colour against
       some part of it. Masking the canvas keeps the large-scale structure
       running straight through the column, just quieter, so there is no edge
       to see. Horizontal only: the column spans the whole scroll height, so
       this never needs updating on scroll. */
    const column = document.querySelector<HTMLElement>('[data-post-article]');
    const syncColumnMask = () => {
      if (!column) return;
      const rect = column.getBoundingClientRect();
      canvas.style.setProperty('--veil-l', `${Math.round(rect.left)}px`);
      canvas.style.setProperty('--veil-r', `${Math.round(rect.right)}px`);
      canvas.setAttribute('data-veiled', '');
    };

    /* The header is opaque (content scrolls under it), so it would sit as a
       flat band across the field. Mirror the matching strip of the field into
       a canvas inside it — one drawImage per frame — so it carries the same
       texture instead of approximating it with a colour. */
    const mirror = document.querySelector<HTMLCanvasElement>('[data-plasma-mirror]');
    const mirrorCtx = mirror?.getContext('2d') ?? null;
    const blitMirror = () => {
      if (!mirror || !mirrorCtx) return;
      const rect = mirror.getBoundingClientRect();
      const w = Math.max(1, Math.ceil(rect.width * dpr));
      const h = Math.max(1, Math.ceil(rect.height * dpr));
      if (mirror.width !== w || mirror.height !== h) {
        mirror.width = w;
        mirror.height = h;
      }
      mirrorCtx.clearRect(0, 0, w, h);
      mirrorCtx.drawImage(
        canvas,
        Math.round(rect.left * dpr), Math.round(rect.top * dpr), w, h,
        0, 0, w, h,
      );
    };

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let raf = 0;
    let last = 0;

    const loop = (now: number) => {
      raf = requestAnimationFrame(loop);
      if (now - last < FRAME_MS) return;
      last = now;
      draw(now * 0.001 * speed);
    };

    const stop = () => {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
    };

    const start = () => {
      stop();
      // Draw once up front so there is a frame to measure the tone from.
      draw(reduceMotion.matches ? 0 : performance.now() * 0.001 * speed);
      // Static single frame under reduced motion: texture stays, motion does not.
      if (reduceMotion.matches) return;
      raf = requestAnimationFrame(loop);
    };

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        resize();
        if (reduceMotion.matches) draw(0);
      }, 150);
    });

    // Don't burn CPU animating a background nobody is looking at.
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });

    reduceMotion.addEventListener('change', start);

    resize();
    start();
  }
</script>
