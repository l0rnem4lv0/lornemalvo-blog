---
import type { TocHeading } from '~/lib/posts';

interface Props {
  headings: TocHeading[];
}

const { headings } = Astro.props;
const enabled = headings.length >= 2;
---

{enabled && (
  <nav class="toc" aria-label="Table of contents">
    <details class="toc-shell" open>
      <summary class="toc-summary">
        <span class="toc-title">Contents</span>
        <span class="toc-chev" aria-hidden="true">▾</span>
      </summary>

      <ul class="toc-list">
        {headings.map((heading) => (
          <li class:list={['toc-item', `toc-depth-${heading.depth}`]}>
            <a
              href={`#${heading.slug}`}
              class="toc-link"
              data-toc-link={heading.slug}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </details>
  </nav>
)}

<script>
  // Scroll-spy: deterministic — active heading is the last one whose top
  // is at or above the threshold line (header height + 20px). This is
  // direction-agnostic: ascending and descending scroll give the same result.
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
  if (links.length > 0) {
    const targets: HTMLElement[] = [];
    const seen = new Set<string>();
    links.forEach((link) => {
      const id = link.dataset.tocLink;
      if (!id || seen.has(id)) return;
      const target = document.getElementById(id);
      if (target) {
        targets.push(target);
        seen.add(id);
      }
    });

    let activeId: string | null = null;
    const setActive = (id: string | null) => {
      if (id === activeId) return;
      activeId = id;
      links.forEach((link) => {
        link.classList.toggle('active', link.dataset.tocLink === id);
      });
    };

    const headerEl = document.querySelector<HTMLElement>('header');
    const OFFSET = (headerEl?.offsetHeight ?? 52) + 20;

    const getActiveId = (): string | null => {
      let candidate: HTMLElement | null = null;
      for (const target of targets) {
        if (target.getBoundingClientRect().top <= OFFSET) {
          candidate = target;
        } else {
          break; // targets are in DOM order; once past threshold we can stop
        }
      }
      return candidate?.id ?? null;
    };

    // After a TOC click, lock briefly so the programmatic scroll doesn't
    // immediately override the clicked heading before the page settles.
    let clickLockUntil = 0;
    const CLICK_LOCK_MS = 800;

    let rafPending = false;
    const onScroll = () => {
      if (performance.now() < clickLockUntil) return;
      if (rafPending) return;
      rafPending = true;
      requestAnimationFrame(() => {
        rafPending = false;
        setActive(getActiveId());
      });
    };

    window.addEventListener('scroll', onScroll, { passive: true });

    // If the page loaded with a hash, mark it active and wait for the browser
    // to finish scrolling to the anchor before recalculating from position.
    const initialHash = decodeURIComponent(window.location.hash.slice(1));
    if (initialHash && seen.has(initialHash)) {
      setActive(initialHash);
      clickLockUntil = performance.now() + CLICK_LOCK_MS;
      setTimeout(() => setActive(getActiveId()), 200);
    } else {
      setActive(getActiveId());
    }

    // Intercept clicks: scroll manually and use replaceState so each TOC
    // jump doesn't push a new entry onto the history stack — otherwise
    // "back" walks through hashes instead of leaving the page.
    const prefersReducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;
    links.forEach((link) => {
      link.addEventListener('click', (event) => {
        const id = link.dataset.tocLink;
        if (!id) return;
        const target = document.getElementById(id);
        if (!target) return;
        event.preventDefault();
        target.scrollIntoView({
          behavior: prefersReducedMotion ? 'auto' : 'smooth',
          block: 'start',
        });
        history.replaceState(null, '', `#${id}`);
        setActive(id);
        clickLockUntil = performance.now() + CLICK_LOCK_MS;
      });
    });
  }
</script>

<style>
  .toc {
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .toc-shell {
    margin: 0;
  }

  .toc-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    list-style: none;
    cursor: pointer;
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border);
    color: var(--fg-muted);
    user-select: none;
  }

  .toc-summary::-webkit-details-marker { display: none; }

  .toc-title {
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .toc-chev {
    font-size: var(--text-xs);
    transition: transform var(--transition-fast) ease;
  }

  .toc-shell[open] .toc-chev {
    transform: rotate(180deg);
  }

  .toc-list {
    list-style: none;
    padding: var(--space-3) 0 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .toc-item.toc-depth-3 {
    padding-left: var(--space-4);
  }

  .toc-link {
    color: var(--fg-muted);
    text-decoration: none;
    line-height: var(--leading-snug);
    display: inline-block;
    border-left: 2px solid transparent;
    padding-left: var(--space-2);
    margin-left: calc(-1 * var(--space-2));
    transition:
      color var(--transition-fast) ease,
      border-color var(--transition-fast) ease;
  }

  .toc-link:hover {
    color: var(--fg);
  }

  .toc-link.active {
    color: var(--accent);
    font-weight: var(--font-medium);
    border-left-color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-link,
    .toc-chev {
      transition: none;
    }
  }

  /* Desktop: sticky sidebar, list always open, no toggle UI. */
  @media (min-width: 769px) {
    .toc {
      position: sticky;
      top: calc(3.25rem + var(--space-6));
      max-height: calc(100vh - 3.25rem - var(--space-12));
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--border) transparent;
    }
    .toc::-webkit-scrollbar { width: 6px; }
    .toc::-webkit-scrollbar-thumb {
      background: var(--border);
      border-radius: 3px;
    }
    .toc::-webkit-scrollbar-track { background: transparent; }

    /* Force-open the disclosure on desktop and hide the toggle. */
    .toc-summary { display: none; }
    .toc-shell[open] .toc-list,
    .toc-list { display: flex; }
    .toc-list { padding-top: 0; }

    .toc-shell::before {
      content: 'Contents';
      display: block;
      font-size: var(--text-xs);
      font-weight: var(--font-medium);
      color: var(--fg-muted);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      padding-bottom: var(--space-3);
      border-bottom: 1px solid var(--border);
      margin-bottom: var(--space-3);
    }
  }
</style>
