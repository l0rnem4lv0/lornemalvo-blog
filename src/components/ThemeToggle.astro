---
import { Icon } from 'astro-icon/components';
import IconButton from '~/components/ui/IconButton.astro';
---

<IconButton
  id="theme-toggle"
  label="Toggle color theme"
  onclick="window.toggleTheme()"
>
  <Icon name="lucide:sun" class="icon-sun" aria-hidden="true" />
  <Icon name="lucide:moon" class="icon-moon" aria-hidden="true" />
</IconButton>

<style is:global>
  /* Show the icon that matches the *active* theme. */
  [data-theme='dark']  #theme-toggle .icon-sun  { display: block; }
  [data-theme='dark']  #theme-toggle .icon-moon { display: none; }
  [data-theme='light'] #theme-toggle .icon-sun  { display: none; }
  [data-theme='light'] #theme-toggle .icon-moon { display: block; }
</style>
