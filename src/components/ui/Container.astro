---
interface Props {
  size?: 'narrow' | 'wide';
  as?: 'div' | 'section' | 'article' | 'main' | 'header' | 'footer';
  class?: string;
}

const { size = 'narrow', as: Tag = 'div', class: className } = Astro.props;
---

<Tag class:list={['container', `container-${size}`, className]}>
  <slot />
</Tag>

<style>
  .container {
    margin-inline: auto;
    padding-inline: var(--space-4);
    width: 100%;
  }
  .container-narrow {
    max-width: var(--container-max);
  }
  .container-wide {
    max-width: var(--container-wide);
  }
  @media (min-width: 640px) {
    .container {
      padding-inline: var(--space-6);
    }
  }
</style>
